import pandas as pd
import requests
from tqdm import tqdm
from concurrent.futures import ThreadPoolExecutor, as_completed


def fetch_chembl_data(smile):
    BASE_URL = "https://www.ebi.ac.uk/chembl/api/data/molecule?molecule_structures__canonical_smiles="
    url = BASE_URL + requests.utils.quote(smile)
    response = requests.get(url, headers={"Accept": "application/json"})
    response.raise_for_status()
    return response.json()


def main():
    smiles = pd.read_csv('smiles_data.csv')['smiles'].tolist()
    results = []
    with ThreadPoolExecutor(max_workers=10) as executor: 
        futures = {executor.submit(fetch_chembl_data, smile): smile for smile in smiles}
        for future in tqdm(as_completed(futures), total=len(smiles), desc="Processing SMILES"):
            results.append(future.result())

if __name__ == "__main__":
    main()
